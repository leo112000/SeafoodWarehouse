# Cấu hình bảo mật Database & JWT cho Docker Compose
# Để ghi đè các giá trị mặc định, hãy sao chép file này thành .env và chỉnh sửa mật khẩu bí mật của bạn.

DB_NAME=SeafoodWarehouseDb
DB_USER=postgres
DB_PASSWORD=ChangeThisPasswordInProduction!
JWT_SECRET_KEY=ChangeThisSecretKeyToYourOwnLongRandomString_Min256Bits_2026!
